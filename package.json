    "appId": "com.comfystudio.app",
    "productName": "Velorn",
    "copyright": "Copyright © 2024-2026",
    "beforePack": "scripts/electron-builder-before-pack.cjs",
    "afterPack": "scripts/electron-builder-after-pack.cjs",
    "artifactBuildCompleted": "scripts/electron-builder-artifact-completed.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/veloEngineCandidate.cjs",
      "!electron/veloCandidateGatewayClient.cjs",
      "!electron/veloOwnerTestGateway.cjs",
      "src/utils/audioVolumeEnvelope.mjs",
      "src/utils/audioEq.mjs",
      "src/utils/audioAnalysisDsp.mjs",
