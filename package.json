      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg*",
      "!node_modules/@derhuerst/ffprobe-static/ffprobe*"
    ],
    "extraResources": [
      {
        "from": "public/workflows",
        "to": "workflows",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffmpeg",
          "ffmpeg.README",
          "ffmpeg.LICENSE",
          "ffmpeg.exe.README",
          "ffmpeg.exe.LICENSE"
        ]
      },
      {
        "from": "node_modules/@derhuerst/ffprobe-static",
        "to": "bin",
        "filter": [
          "ffprobe.exe",
          "ffprobe",
          "ffprobe.README",
          "ffprobe.LICENSE",
          "ffprobe.exe.README",
          "ffprobe.exe.LICENSE"
        ]
      },
      {
